---
import { samples } from '../data/site';
---

<section class="samples" id="samples">
  <div class="container">
    <div class="head head--centre" data-reveal>
      <h2>Fewer keystrokes, measured.</h2>
      <p class="lead">The share you skip if you keep every right suggestion.</p>
    </div>
    <ol class="samples__stack">
      {samples.map((sample, i) => (
        <li class={`card card--${sample.tint}`} style={`--n:${i}`}>
          <p class="card__name">{sample.name}</p>
          <p class="card__text" lang={sample.lang}>{sample.typed}<span class="card__caret" aria-hidden="true"></span><span class="card__ghost">{sample.ghost}</span></p>
          <p class="card__figure"><b data-count={sample.saved}>{sample.saved}%</b><span>fewer keystrokes</span></p>
        </li>
      ))}
    </ol>
    <p class="caption samples__caption">Example sentences. Figures replayed offline on an i5-9300H laptop with the standard model.</p>
  </div>
</section>

<script>
  const figures = document.querySelectorAll<HTMLElement>('[data-count]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still) {
    const count = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          count.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const goal = Number(el.dataset.count);
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / 900);
            el.textContent = `${Math.round(goal * (1 - Math.pow(1 - t, 3)))}%`;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    figures.forEach((el) => count.observe(el));
  }
</script>

<style>
  .samples { padding-block: var(--section-gap) var(--section-gap-s); }
  .samples__stack { display: grid; gap: var(--space-xl); margin: 0 auto; padding: 0; max-width: 980px; list-style: none; }
  .card { position: sticky; top: calc(7rem + var(--n) * 1.25rem); display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name name" "text figure"; align-items: end; gap: var(--space-lg) var(--space-2xl); min-height: 22rem; padding: var(--space-xl) var(--space-2xl); border: 1px solid color-mix(in oklab, var(--color-ink) 10%, transparent); border-radius: var(--radius-card); box-shadow: 0 -12px 40px -28px var(--color-shadow); }
  .card--butter { background: var(--color-butter); }
  .card--peach { background: var(--color-peach); }
  .card--sky { background: var(--color-sky); }
  .card--sage { background: var(--color-sage); }
  .card--paper { background: var(--color-paper-3); }
  .card__name { grid-area: name; align-self: start; font-weight: 600; }
  .card__text { grid-area: text; max-width: 30ch; font-family: var(--font-display); font-size: var(--text-2xl); line-height: 1.3; }
  .card__caret { display: inline-block; width: 2px; height: 1em; margin-inline: 2px; vertical-align: -0.12em; background: var(--color-caret); }
  .card__ghost { color: color-mix(in oklab, var(--color-ink) 52%, transparent); }
  .card__figure { grid-area: figure; display: grid; justify-items: end; text-align: right; }
  .card__figure b { font-family: var(--font-display); font-size: var(--text-figure); font-weight: 400; line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .card__figure span { color: var(--color-ink-2); font-size: var(--text-sm); }
  .samples__caption { text-align: center; }
  @media (max-width: 40rem) {
    .card { grid-template-areas: "name" "text" "figure"; grid-template-columns: minmax(0, 1fr); min-height: 0; padding: var(--space-lg); top: calc(5.5rem + var(--n) * 0.75rem); }
    .card__figure { justify-items: start; text-align: left; }
  }
</style>
