---
import { ticker } from '../data/site';

const rows = [ticker, ticker];
---

<section class="ticker" aria-labelledby="ticker-head">
  <h2 class="ticker__head" id="ticker-head">Writes with you in English, German and Spanish.</h2>
  <div class="ticker__track">
    {rows.map((row, r) => (
      <ul class="ticker__row" aria-hidden={r > 0 ? 'true' : undefined}>
        {row.map((item) => (
          <li lang={item.lang}>{item.typed}<span class="ticker__caret" aria-hidden="true"></span><span class="ticker__ghost">{item.ghost}</span></li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .ticker { --color-focus: var(--color-focus-dark); position: relative; z-index: var(--z-raised); margin-top: calc(var(--radius-band) * -1); padding-block: var(--space-2xl) var(--space-3xl); border-radius: var(--radius-band) var(--radius-band) 0 0; background: var(--color-ink); color: var(--color-on-dark); overflow: hidden; }
  .ticker__head { max-width: none; font-family: var(--font-body); letter-spacing: 0; line-height: 1.4; margin-bottom: var(--space-xl); color: var(--color-on-dark-muted); font-size: var(--text-sm); font-weight: 500; text-align: center; }
  .ticker__track { display: flex; width: max-content; }
  .ticker__row { display: flex; gap: var(--space-3xl); margin: 0; padding: 0 var(--space-3xl) 0 0; list-style: none; font-family: var(--font-display); font-size: var(--text-2xl); white-space: nowrap; }
  .ticker__caret { display: inline-block; width: 2px; height: 1em; margin-inline: 2px; vertical-align: -0.12em; background: var(--color-caret); }
  .ticker__ghost { color: var(--color-on-dark-ghost); }
  @media (prefers-reduced-motion: no-preference) {
    .ticker__track { animation: slide 48s linear infinite; }
    .ticker:hover .ticker__track { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { width: auto; }
    .ticker__row { display: grid; grid-template-columns: repeat(2, auto); justify-content: center; gap: var(--space-md) var(--space-2xl); padding: 0 var(--gutter); white-space: normal; text-align: center; }
    .ticker__row[aria-hidden] { display: none; }
  }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
