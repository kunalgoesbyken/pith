---
import Wordmark from './Wordmark.astro';
import { links } from '../data/site';

const footLinks = [
  { href: links.repo, label: 'GitHub' },
  { href: links.releases, label: 'Releases' },
  { href: links.privacy, label: 'Privacy' },
  { href: links.licence, label: 'GPL-3.0 licence' },
];
---

<section class="close">
  <div class="container close__inner" data-reveal>
    <h2>Try it on your own sentences<span class="close__caret" aria-hidden="true"></span></h2>
    <p class="lead">The welcome window fetches the model once.</p>
    <div class="actions close__actions">
      <a class="btn close__btn" href={links.download}>Download for Windows</a>
      <a class="btn btn--quiet close__quiet" href={links.releases}>All releases</a>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="container foot__inner">
    <a class="foot__home" href="#top" aria-label="Pith, back to the top"><Wordmark size="foot" /></a>
    <ul class="foot__links">
      {footLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <p class="foot__legal">Built in Rust on llama.cpp.</p>
  </div>
</footer>

<style>
  .close { padding-block: var(--section-gap-s); }
  .close__inner { --color-focus: var(--color-focus-dark); display: grid; justify-items: center; gap: var(--space-lg); padding: var(--space-3xl) var(--space-xl); border-radius: var(--radius-band); background: var(--color-ink); color: var(--color-on-dark); text-align: center; }
  .close h2 { font-size: var(--text-section); text-wrap: balance; }
  .close__caret { display: inline-block; width: 0.05em; height: 0.8em; margin-left: 0.06em; vertical-align: -0.06em; border-radius: 2px; background: var(--color-caret); }
  .close .lead { color: var(--color-on-dark-muted); }
  .close__actions { justify-content: center; margin-top: var(--space-sm); }
  .close__btn { border-color: var(--color-on-dark); background: var(--color-on-dark); color: var(--color-ink); }
  .close__btn:hover { background: var(--color-paper-2); }
  .close__quiet { border-color: var(--color-on-dark-ghost); color: var(--color-on-dark); }
  .close__quiet:hover { background: var(--color-cocoa-2); }
  .foot { padding-block: var(--space-xl) var(--space-2xl); }
  .foot__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-xl); }
  .foot__home { text-decoration: none; border-radius: var(--radius-key); }
  .foot__home:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 4px; }
  .foot__links { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-lg); margin: 0 0 0 auto; padding: 0; list-style: none; }
  .foot__links a { display: inline-block; padding-block: var(--space-xs); color: var(--color-ink-2); font-size: var(--text-sm); }
  .foot__links a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .foot__legal { flex-basis: 100%; color: var(--color-muted); font-size: var(--text-sm); }
  @media (prefers-reduced-motion: no-preference) {
    .close__caret { animation: blink 1.06s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 40rem) { .foot__links { margin-left: 0; } }
</style>
