---
interface Props {
  size?: 'nav' | 'foot';
}

const { size = 'nav' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>pith<span class="wordmark__caret" aria-hidden="true"></span></span>

<style>
  .wordmark { display: inline-flex; align-items: center; gap: 0.06em; font-family: var(--font-display); font-weight: 500; letter-spacing: -0.03em; line-height: 1; color: var(--color-ink); }
  .wordmark--nav { font-size: 1.75rem; }
  .wordmark--foot { font-size: 2.25rem; }
  .wordmark__caret { width: 0.1em; height: 0.92em; margin-top: 0.08em; border-radius: 1px; background: var(--color-caret); }
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .wordmark .wordmark__caret, .wordmark:hover .wordmark__caret { animation: blink 1s steps(1) infinite; }
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>
