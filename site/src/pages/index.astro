---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import How from '../components/How.astro';
import Samples from '../components/Samples.astro';
import Laptop from '../components/Laptop.astro';
import Models from '../components/Models.astro';
import Faq from '../components/Faq.astro';
import Close from '../components/Close.astro';
---

<Base title="Pith: local autocomplete for every text box" description="Pith shows the rest of your sentence in grey as you type, using a small model on your own CPU. Free, no account, nothing sent.">
  <Nav />
  <main>
    <Hero />
    <Ticker />
    <How />
    <Samples />
    <Laptop />
    <Models />
    <Faq />
  </main>
  <Close />
</Base>
